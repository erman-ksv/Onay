# Fill locally on the server. Never commit the completed .env file.
ONAY_DOMAIN=
ACME_EMAIL=
ADMIN_PHONE=
# Generate two DIFFERENT values with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
POSTGRES_PASSWORD=
SESSION_SECRET=
ONAY_IMAGE_TAG=staging

# Real SMS stays disabled until provider-key setup and an explicit acceptance test.
TEZJET_SMS_PROVIDER=
TEZJET_SMS_SEND_ENABLED=false
DEVSMS_API_KEY=
TEZJET_SMS_SERVICE_NAME=Onay
TEZJET_SMS_TIMEOUT_MS=8000
