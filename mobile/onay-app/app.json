{
  "expo": {
    "name": "Onay",
    "slug": "onay",
    "scheme": "onay",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Onay использует местоположение только по запросу, чтобы оформить поездку."
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uz.onay.app"
    },
    "android": {
      "package": "uz.onay.app",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}